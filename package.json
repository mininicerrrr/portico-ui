{
  "name": "portico-ui",
  "version": "0.1.0",
  "description": "A compact Vue 3 component library for practical admin and form interfaces.",
  "license": "MIT",
  "author": "Portico UI Contributors",
  "type": "module",
  "main": "./dist/portico-ui.umd.js",
  "module": "./dist/portico-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/portico-ui.es.js",
      "require": "./dist/portico-ui.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "typescript",
    "admin",
    "form",
    "portico-ui"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "docs": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  }
}
